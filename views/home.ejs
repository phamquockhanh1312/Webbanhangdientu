<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Website bán hàng điện tử</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header>
    <h1>WEBSITE BÁN HÀNG ĐIỆN TỬ</h1>

    <nav>
        <a href="/">Trang chủ</a>
        <a href="#">Sản phẩm</a>
        <a href="#">Giỏ hàng</a>
        <a href="#">Đăng nhập</a>
    </nav>
</header>

<main>

    <section class="banner">
        <h2>Chào mừng đến với cửa hàng điện tử</h2>
        <p>Điện thoại - Laptop - Máy tính - Tai nghe - Loa - Phụ kiện</p>
    </section>

    <section class="products">

        <h2>Sản phẩm nổi bật</h2>

        <div class="product-list">

            <div class="product">
                <div class="product-image">
                    Hình sản phẩm
                </div>

                <h3>Điện thoại</h3>

                <p>Điện thoại thông minh</p>

                <strong>10.000.000 VNĐ</strong>
            </div>

            <div class="product">
                <div class="product-image">
                    Hình sản phẩm
                </div>

                <h3>Laptop</h3>

                <p>Laptop phục vụ học tập và làm việc</p>

                <strong>20.000.000 VNĐ</strong>
            </div>

            <div class="product">
                <div class="product-image">
                    Hình sản phẩm
                </div>

                <h3>Tai nghe</h3>

                <p>Tai nghe không dây</p>

                <strong>1.500.000 VNĐ</strong>
            </div>

        </div>

    </section>

</main>

<footer>
    <p>Website bán hàng điện tử</p>
</footer>

</body>
</html>