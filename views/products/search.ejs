<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tìm kiếm - TECHSTORE</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header>

    <div class="header-inner">

        <a href="/" class="logo">
            TECHSTORE
        </a>

        <nav>

            <a href="/">
                Trang chủ
            </a>

            <a href="/products">
                Sản phẩm
            </a>

            <a href="/cart">
                🛒 Giỏ hàng
            </a>

            <% if (sessionUser) { %>

                <a href="/auth/profile">
                    👤 Tài khoản
                </a>

                <a href="/orders/history">
                    📦 Đơn hàng
                </a>

                <a href="/auth/logout">
                    Đăng xuất
                </a>

            <% } else { %>

                <a href="/auth/login">
                    Đăng nhập
                </a>

                <a href="/auth/register">
                    Đăng ký
                </a>

            <% } %>

        </nav>

    </div>

</header>


<main>

    <section class="products-page">

        <div class="products-page-header">

            <div>

                <span class="section-label">
                    SEARCH RESULTS
                </span>

                <h1>
                    Kết quả tìm kiếm
                </h1>

                <p>
                    Kết quả cho từ khóa:
                    <strong>
                        "<%= keyword %>"
                    </strong>
                </p>

            </div>


            <form
                action="/products/search"
                method="GET"
                class="product-search"
            >

                <input
                    type="text"
                    name="keyword"
                    value="<%= keyword %>"
                    placeholder="Tìm kiếm sản phẩm..."
                >

                <button type="submit">
                    🔍
                </button>

            </form>

        </div>


        <div class="category-filter">

            <a
                href="/products"
                class="category-filter-item"
            >
                Tất cả
            </a>

            <a
                href="/products/category/Điện thoại"
                class="category-filter-item"
            >
                📱 Điện thoại
            </a>

            <a
                href="/products/category/Laptop"
                class="category-filter-item"
            >
                💻 Laptop
            </a>

            <a
                href="/products/category/Tai nghe"
                class="category-filter-item"
            >
                🎧 Tai nghe
            </a>

            <a
                href="/products/category/Loa"
                class="category-filter-item"
            >
                🔊 Loa
            </a>

            <a
                href="/products/category/Phụ kiện"
                class="category-filter-item"
            >
                🖱️ Phụ kiện
            </a>

        </div>


        <% if (!products || products.length === 0) { %>

            <div class="empty-products">

                <div class="empty-products-icon">
                    🔍
                </div>

                <h2>
                    Không tìm thấy sản phẩm
                </h2>

                <p>
                    Không có sản phẩm nào phù hợp với từ khóa
                    "<%= keyword %>".
                </p>

                <a
                    href="/products"
                    class="detail-back-button"
                >
                    Xem tất cả sản phẩm
                </a>

            </div>

        <% } else { %>

            <div class="products-grid">

                <% products.forEach(product => { %>

                    <article class="product-card">

                        <div class="product-card-image">

                            <span class="product-badge">
                                HOT
                            </span>

                            <img
                                src="<%= product.image %>"
                                alt="<%= product.name %>"
                            >

                        </div>


                        <div class="product-card-content">

                            <span class="product-category">
                                <%= product.category %>
                            </span>

                            <h2>
                                <%= product.name %>
                            </h2>

                            <div class="product-rating">

                                <span>
                                    ★★★★★
                                </span>

                                <small>
                                    4.9
                                </small>

                            </div>

                            <p>
                                <%= product.description %>
                            </p>


                            <div class="product-card-bottom">

                                <div class="product-price">
                                    <%= product.price %>
                                </div>

                                <span class="stock-label">
                                    ● Còn hàng
                                </span>

                            </div>


                            <div class="product-card-actions">

                                <a
                                    href="/products/<%= product.id %>"
                                    class="product-detail-button"
                                >
                                    Xem chi tiết
                                </a>

                                <form
                                    action="/cart/add"
                                    method="POST"
                                >

                                    <input
                                        type="hidden"
                                        name="productId"
                                        value="<%= product.id %>"
                                    >

                                    <button
                                        type="submit"
                                        class="product-cart-button"
                                    >
                                        🛒
                                    </button>

                                </form>

                            </div>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </section>

</main>


<footer>

    <div class="footer-inner">

        <div>

            <h3>
                TECHSTORE
            </h3>

            <p>
                Cửa hàng điện tử hiện đại
            </p>

        </div>

        <div>

            <strong>
                Sản phẩm
            </strong>

            <p>
                Điện thoại • Laptop • Tai nghe
            </p>

        </div>

        <div>

            <strong>
                Hỗ trợ
            </strong>

            <p>
                Giao hàng nhanh • Thanh toán an toàn
            </p>

        </div>

    </div>

</footer>

</body>

</html>