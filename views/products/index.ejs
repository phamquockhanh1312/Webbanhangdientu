            <strong>20.000.000 VNĐ</strong>
        </div>

        <div class="product">
            <div class="product-image">
                Hình sản phẩm
            </div>

            <h3>
                <a href="/products/3">Tai nghe</a>
            </h3>

            <p>Tai nghe không dây</p>

            <strong>1.500.000 VNĐ</strong>
