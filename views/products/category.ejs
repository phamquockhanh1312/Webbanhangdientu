<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh mục sản phẩm</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header>
    <h1>WEBSITE BÁN HÀNG ĐIỆN TỬ</h1>

    <nav>
        <a href="/">Trang chủ</a>
        <a href="/products">Sản phẩm</a>
        <a href="#">Giỏ hàng</a>
        <a href="#">Đăng nhập</a>
    </nav>
</header>

<main>

    <h2>Danh mục: <%= category %></h2>

    <div class="category-menu">
        <a href="/products/category/Điện thoại">Điện thoại</a>
        <a href="/products/category/Laptop">Laptop</a>
        <a href="/products/category/Tai nghe">Tai nghe</a>
        <a href="/products/category/Loa">Loa</a>
        <a href="/products/category/Phụ kiện">Phụ kiện</a>
    </div>

    <% if (products.length === 0) { %>

        <p>Không có sản phẩm trong danh mục này.</p>

    <% } else { %>

        <div class="product-list">

            <% products.forEach(product => { %>

                <div class="product">

                    <div class="product-image">
                        Hình sản phẩm
                    </div>

                    <h3>
                        <a href="/products/<%= product.id %>">
                            <%= product.name %>
                        </a>
                    </h3>

                    <p>
                        <%= product.description %>
                    </p>

                    <strong>
                        <%= product.price %>
                    </strong>

                </div>

            <% }) %>

        </div>

    <% } %>

</main>

<footer>
    <p>Website bán hàng điện tử</p>
</footer>

</body>
</html>