<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết sản phẩm</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header>
    <h1>WEBSITE BÁN HÀNG ĐIỆN TỬ</h1>

    <nav>
        <a href="/">Trang chủ</a>
        <a href="/products">Sản phẩm</a>
        <a href="#">Giỏ hàng</a>
        <a href="#">Đăng nhập</a>
    </nav>
</header>

<main>

    <h2>Chi tiết sản phẩm</h2>

    <div class="product">
        <div class="product-image">
            Hình sản phẩm
        </div>

        <h3>Sản phẩm số <%= id %></h3>

        <p>Đây là thông tin chi tiết của sản phẩm.</p>

        <strong>10.000.000 VNĐ</strong>

        <br><br>

        <button>Thêm vào giỏ hàng</button>
    </div>

</main>

<footer>
    <p>Website bán hàng điện tử</p>
</footer>

</body>
</html>
